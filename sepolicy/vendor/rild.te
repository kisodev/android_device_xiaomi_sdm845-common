dontaudit rild tombstone_data_file:dir search;
dontaudit rild vendor_file:file ioctl;
allow rild vendor_data_file:dir rw_file_perms;
allow rild vendor_data_file:file rw_file_perms;

set_prop(rild, deviceid_prop)

# Allow binder communication with vendor_qtidataservices_app
binder_call(rild, vendor_qtidataservices_app)

